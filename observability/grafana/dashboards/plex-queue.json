  "panels": [
    {
      "title": "Import cycles (by status)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (rate(plex_queue_import_cycles_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "Tidy applies (by status)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (rate(plex_queue_tidy_applies_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "Domain events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (event, status) (rate(plex_queue_events_total[5m]))",
          "legendFormat": "{{event}} {{status}}"
        }
      ]
    },
    {
      "title": "Import / tidy duration (p95 ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(plex_queue_operation_duration_milliseconds_bucket[5m])))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "title": "Recent plex-queue events (Loki)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service_name=\"plex-queue\"} |= \"event\"",
          "queryType": "range"
        }
      ]
    }
  ],
